# ── Biometric data — NEVER commit ────────────────────────────────
# Local, machine-specific vault location (never commit a personal path).
/.vault-path
/data/*
!/data/README.md
/captures/*
!/captures/README.md
*.pcapng
*.pcap
*.pgm
# raw frame dumps / enrolled templates
*.fp
*.template
*.raw

# ── Vendored upstreams (use your own forks as submodules) ─────────
# Re-point these to your forks per vendor/README.md; don't commit the trees.
/vendor/*
!/vendor/README.md

# ── Python ───────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# ── Build / misc ─────────────────────────────────────────────────
build/
*.o
*.so
.DS_Store

# ── M3 build artifacts ───────────────────────────────────────────
# 3a throwaway fork clone is already covered by /vendor/* above.
/research/sigfm_c/builddir/
/research/sigfm_c/harness
